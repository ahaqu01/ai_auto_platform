# Local development template only. Never copy these values to staging or production.
APP_ENV=local
APP_NAME=ai-auto-platform
APP_VERSION=0.1.0

# Local infrastructure started by deploy/compose/docker-compose.yml.
DATABASE_URL=postgresql+psycopg://platform:platform@127.0.0.1:5432/platform
REDIS_URL=redis://127.0.0.1:6379/0
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default

# Local identity placeholder. M1 will provide Keycloak Realm/Client IaC.
KEYCLOAK_ISSUER=http://127.0.0.1:8081/realms/platform
OIDC_AUDIENCE=platform-api
BFF_CLIENT_ID=platform-bff
BFF_CLIENT_SECRET=bff-local-development-only
BFF_PUBLIC_ORIGIN=http://127.0.0.1:8080
BFF_CALLBACK_URL=http://127.0.0.1:8080/auth/callback

# Local MinIO endpoints. Do not place OSS access keys in this file.
OSS_PROVIDER=minio
OSS_REGION=us-east-1
OSS_ACCESS_KEY_ID=minio-local-only
OSS_ACCESS_KEY_SECRET=minio-local-only
OSS_SESSION_TOKEN=
OSS_PUBLIC_ENDPOINT=http://127.0.0.1:9000
OSS_INTERNAL_ENDPOINT=http://127.0.0.1:9000
OSS_BUCKET=platform-local

OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Explicit waiver for trusted private .internal/IP service networks only.
ALLOW_INSECURE_PRIVATE_SERVICE_TRANSPORT=false
