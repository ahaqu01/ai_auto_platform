POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=<generate-outside-repository>
MINIO_ROOT_USER=<generate-outside-repository>
MINIO_ROOT_PASSWORD=<generate-outside-repository>
# Trusted-LAN HTTP integration uses local validation semantics. Use staging only with TLS/DNS.
APP_ENV=local
APP_NAME=ai-auto-platform
APP_VERSION=<git-commit>
DATABASE_URL=postgresql+psycopg://platform:<password>@postgres:5432/platform
REDIS_URL=redis://redis:6379/0
KEYCLOAK_ISSUER=http://127.0.0.1:8081/auth/realms/ai-platform-staging
KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/auth/realms/ai-platform-staging
OIDC_AUDIENCE=platform-api
BFF_CLIENT_ID=platform-bff
BFF_CLIENT_SECRET=<generate-outside-repository>
BFF_PUBLIC_ORIGIN=http://127.0.0.1:8081
BFF_CALLBACK_URL=http://127.0.0.1:8081/auth/callback
BFF_COOKIE_NAME=platform_session
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=<generate-outside-repository>
OSS_PUBLIC_ENDPOINT=https://objects.staging.example.invalid
OSS_INTERNAL_ENDPOINT=http://minio:9000
OSS_BUCKET=staging
TEMPORAL_ADDRESS=temporal.staging.example.invalid:7233
ALLOW_INSECURE_PRIVATE_SERVICE_TRANSPORT=true
STAGING_HTTP_PORT=8081
STAGING_ENV_FILE=/home/diffgram/.config/ai-auto-platform/staging.env
